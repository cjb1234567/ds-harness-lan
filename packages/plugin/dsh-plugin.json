{
  "$schema": "https://dsh.community/schemas/dsh-plugin-0.15.json",
  "id": "community.ds-harness-lan",
  "name": "ds-harness-lan",
  "version": "0.5.23-lan.1",
  "manifestVersion": "0.15",
  "facets": {
    "host": {
      "entry": "dist/index.js",
      "apiVersion": "v1alpha1"
    }
  },
  "requires": {
    "contracts": [
      {
        "apiVersion": "commands.dsh/v1alpha1",
        "kind": "Command"
      }
    ]
  },
  "contributes": {
    "commands": [
      {
        "id": "ds-harness.lan",
        "title": "Manage DSH LAN Host and direct connection status"
      }
    ]
  },
  "permissions": [
    {
      "name": "commands.invoke",
      "scope": "ds-harness.lan",
      "reason": "manage LAN Host and direct IP-and-port connection status from dsh-TUI"
    }
  ],
  "subscriptions": [],
  "license": "MIT",
  "source": {
    "repository": "https://github.com/cjb1234567/ds-harness-lan"
  }
}
